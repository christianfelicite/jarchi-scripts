/*
 * Objectif   : exporter une ou plusieurs vues ArchiMate au format draw.io.
 * Prérequis  : sélectionner une ou plusieurs vues dans l'arbre du modèle,
 *              ou un objet dans une vue ouverte.
 * Effets     : aucun sur le modèle. Écrit un fichier .drawio, une page par vue.
 * Fidélité   : positions, tailles, imbrication, couleurs, libellés et
 *              propriétés sont conservés. Formes : pictogrammes de la palette
 *              draw.io « ArchiMate 3.2 », couleurs Archi.
 *              Points de cassure : formule d'Archi (pondération source/cible).
 *              Images : objets image et images des éléments, notes et
 *              groupes (personnalisées ou de spécialisation), intégrées au
 *              fichier. Comme dans Archi, une image masque le pictogramme
 *              sauf si l'icône est forcée.
 * Écarts     : draw.io ne rogne pas une image plus grande que sa forme :
 *              elle est réduite pour y tenir. Le remplissage « Fill » d'Archi
 *              (recadrage) devient un ajustement sans recadrage.
 *              Extrémité sur une relation : point de référence pris au milieu
 *              de cette relation, sans ses propres points de cassure.
 */
load(__DIR__ + "../lib/commun.js");

var TAILLE_DEFAUT = { width: 120, height: 55 };

// Couleurs par défaut d'Archi, par couche.
var COULEURS = {
    strategie: "#F5DEAA",
    metier: "#FFFFB5",
    application: "#B5FFFF",
    technologie: "#C9E7B7",
    motivation: "#CCCCFF",
    implementation: "#FFE0E0",
    localisation: "#FBB875",
    autre: "#FFFFFF"
};

// Une règle par couche plutôt qu'une table par type.
var COUCHES = [
    ["metier", /^(business-.*|contract|representation|product)$/],
    ["application", /^(application-.*|data-object)$/],
    ["technologie", /^(technology-.*|node|device|system-software|communication-network|path|artifact|equipment|facility|distribution-network|material)$/],
    ["motivation", /^(stakeholder|driver|assessment|goal|outcome|principle|requirement|constraint|meaning|value)$/],
    ["strategie", /^(resource|capability|value-stream|course-of-action)$/],
    ["implementation", /^(work-package|deliverable|implementation-event|plateau|gap)$/],
    ["localisation", /^location$/]
];

// Pictogrammes draw.io (palette « ArchiMate 3.2 ») :
// shape=mxgraph.archimate3.application;appType=…;archiType=….
// appType se déduit du suffixe du type jArchi, sauf exceptions ci-dessous.
// Les autres types portent leur propre nom (node, goal, product…).
var APPTYPE_SUFFIXE = {
    actor: "actor", role: "role", collaboration: "collab", interface: "interface",
    process: "proc", "function": "func", interaction: "interaction", event: "event", service: "serv"
};
var APPTYPE_EXCEPTIONS = {
    "application-component": "comp", "business-object": "passive", "data-object": "passive",
    "system-software": "sysSw", "communication-network": "netw", "distribution-network": "distribution",
    "work-package": "workPackage", "value-stream": "valueStream", "course-of-action": "course",
    "stakeholder": "role", "assessment": "assess", "value": "amValue"
};
// archiType : oct pour la motivation, rounded pour le comportement, square sinon.
// Ces types n'en ont pas dans la palette draw.io : leur forme est propre.
var SANS_ARCHITYPE = { device: 1, deliverable: 1, plateau: 1, gap: 1 };

// Notation des relations ArchiMate en style draw.io.
var RELATIONS = {
    "composition-relationship": "startArrow=diamondThin;startFill=1;startSize=12",
    "aggregation-relationship": "startArrow=diamondThin;startFill=0;startSize=12",
    "assignment-relationship": "startArrow=oval;startFill=1;endArrow=block;endFill=1",
    "realization-relationship": "dashed=1;endArrow=block;endFill=0",
    "serving-relationship": "endArrow=open",
    "access-relationship": "dashed=1;dashPattern=1 4",
    "influence-relationship": "dashed=1;dashPattern=6 4;endArrow=open",
    "triggering-relationship": "endArrow=block;endFill=1",
    "flow-relationship": "dashed=1;dashPattern=6 4;endArrow=block;endFill=1",
    "specialization-relationship": "endArrow=block;endFill=0;endSize=12"
};

var SENS_ACCES = {
    write: "endArrow=open",
    read: "startArrow=open",
    readwrite: "startArrow=open;endArrow=open",
    access: ""
};

// Codes Archi : textAlignment 1/2/4, textPosition 0/1/2.
var ALIGNEMENT = { 1: "left", 2: "center", 4: "right" };
var POSITION = { 0: "top", 1: "middle", 2: "bottom" };

// Codes Archi des images.
var SOURCE_IMAGE_SPECIALISATION = 0;   // imageSource : 0 spécialisation, 1 personnalisée
var POSITION_IMAGE_REMPLIR = 9;        // imagePosition : 0..8 grille 3×3 ligne par ligne, 9 remplir
var ICONE_TOUJOURS = 1;                // showIcon : 0 si pas d'image, 1 toujours, 2 jamais
var ICONE_JAMAIS = 2;

// Les octets des images ne sont pas exposés par jArchi : lecture par l'archive Archi.
var Base64 = Java.type("java.util.Base64");
var IEditorModelManager = Java.type("com.archimatetool.editor.model.IEditorModelManager");
var IArchiveManager = Java.type("com.archimatetool.editor.model.IArchiveManager");

// ---------------------------------------------------------------------------

function xml(s) {
    return String(s === undefined || s === null ? "" : s)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;").replace(/\r?\n/g, "&#10;");
}

/** Libellé interprété en HTML par draw.io (html=1, nécessaire au retour à la ligne). */
function libelle(s) {
    return xml(String(s === undefined ? "" : s)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        .replace(/\r?\n/g, "<br>"));
}

/** Fusionne "k=v;k=v" dans un objet de style. Les clés suivantes écrasent. */
function fusionner(style, texte) {
    if (!texte) return style;
    texte.split(";").forEach(function (paire) {
        if (!paire) return;
        var i = paire.indexOf("=");
        if (i < 0) style[paire] = null; else style[paire.slice(0, i)] = paire.slice(i + 1);
    });
    return style;
}

function serialiser(style) {
    return Object.keys(style).map(function (k) {
        return style[k] === null ? k : k + "=" + style[k];
    }).join(";") + ";";
}

function estConnexion(o) {
    return /-relationship$/.test(o.type) || o.type === "diagram-model-connection";
}

function couche(type) {
    for (var i = 0; i < COUCHES.length; i++) {
        if (COUCHES[i][1].test(type)) return COUCHES[i][0];
    }
    return "autre";
}

function appType(type) {
    return APPTYPE_EXCEPTIONS[type] || APPTYPE_SUFFIXE[type.split("-").pop()] || type;
}

function archiType(type) {
    if (couche(type) === "motivation") return "oct";
    return /(process|function|interaction|event|service|capability|value-stream|course-of-action|work-package)$/.test(type)
        ? "rounded" : "square";
}

/** Type ArchiMate, documentation et propriétés, en attributs du UserObject. */
function metadonnees(o) {
    var c = lire(o, "concept");
    if (!c) return "";
    var attrs = ' archimateType="' + xml(o.type) + '"';
    var doc = lire(c, "documentation");
    if (doc) attrs += ' tooltip="' + xml(doc) + '"';
    var reserves = { id: 1, label: 1, placeholders: 1, tooltip: 1, link: 1, archimateType: 1 };
    var cles = c.prop() || [];
    for (var i = 0; i < cles.length; i++) {
        var nom = String(cles[i]).replace(/[^A-Za-z0-9_.-]/g, "_");
        if (!/^[A-Za-z_]/.test(nom)) nom = "_" + nom;
        if (reserves[nom]) continue;   // doublon ou nom réservé
        reserves[nom] = 1;
        attrs += " " + nom + '="' + xml(c.prop(cles[i])) + '"';
    }
    return attrs;
}

// ---------------------------------------------------------------------------
// Images

var archive = null;          // IArchiveManager du modèle, initialisé au lancement
var imagesEncodees = {};     // chemin dans l'archive → URI data, une seule lecture par image

function archiveDuModele() {
    try {
        var modeles = IEditorModelManager.INSTANCE.getModels();
        for (var i = 0; i < modeles.size(); i++) {
            var m = modeles.get(i);
            if (String(m.getId()) === String(model.id)) return m.getAdapter(IArchiveManager.class);
        }
    } catch (e) {
        console.log("Archive du modèle inaccessible, images ignorées : " + e);
    }
    return null;
}

/** Valeur d'un objet image jArchi (Map Java) : accès par membre ou par get(). */
function champ(m, cle) {
    var v = lire(m, cle);
    if (v === undefined) {
        try { v = m.get(cle); } catch (e) { v = undefined; }
    }
    return v === null ? undefined : v;
}

function typeMime(octets) {
    var a = octets[0] & 0xFF, b = octets[1] & 0xFF;
    if (a === 0x89 && b === 0x50) return "image/png";
    if (a === 0xFF && b === 0xD8) return "image/jpeg";
    if (a === 0x47 && b === 0x49) return "image/gif";
    if (a === 0x42 && b === 0x4D) return "image/bmp";
    if (a === 0x3C) return "image/svg+xml";
    return "image/png";
}

/** URI data au format draw.io (« data:type,base64 », sans « ;base64 » : « ; » sépare les styles). */
function uriImage(chemin) {
    if (!chemin || !archive) return null;
    if (imagesEncodees.hasOwnProperty(chemin)) return imagesEncodees[chemin];
    var uri = null;
    try {
        var octets = archive.getBytesFromEntry(chemin);
        if (octets && octets.length > 1) {
            uri = "data:" + typeMime(octets) + "," + Base64.getEncoder().encodeToString(octets);
        }
    } catch (e) {
        console.log("Image illisible (" + chemin + ") : " + e);
    }
    imagesEncodees[chemin] = uri;
    return uri;
}

/** Image affichée par Archi pour cet objet : personnalisée, ou celle de la spécialisation. */
function imageDe(o) {
    var img;
    if (lire(o, "imageSource") === SOURCE_IMAGE_SPECIALISATION) {
        var c = lire(o, "concept");
        var spe = c && lire(c, "specialization");
        var profil = spe ? model.findSpecialization(spe, c.type) : null;
        img = profil ? lire(profil, "image") : undefined;
    } else {
        img = lire(o, "image");
    }
    if (!img) return null;
    var uri = uriImage(champ(img, "path"));
    if (!uri) return null;
    return { uri: uri, width: Number(champ(img, "width")) || 0, height: Number(champ(img, "height")) || 0 };
}

/**
 * Cellule image enfant de la forme, placée comme dans Archi (taille naturelle,
 * grille 3×3). Réduite si elle dépasse la forme : draw.io ne la rognerait pas.
 */
function celluleImage(o, img, w, h) {
    var x = 0, y = 0, iw = w, ih = h;
    var pos = lire(o, "imagePosition");
    if (pos === undefined) pos = 2;   // haut droite, défaut d'Archi
    if (pos !== POSITION_IMAGE_REMPLIR && img.width > 0 && img.height > 0) {
        var r = Math.min(1, w / img.width, h / img.height);
        iw = Math.round(img.width * r);
        ih = Math.round(img.height * r);
        var col = pos % 3, ligne = Math.floor(pos / 3);
        x = col === 0 ? 0 : col === 1 ? Math.round((w - iw) / 2) : w - iw;
        y = ligne === 0 ? 0 : ligne === 1 ? Math.round((h - ih) / 2) : h - ih;
    }
    return '<mxCell id="' + xml(o.id + "-image") + '" value="" style="' +
        xml("shape=image;imageAspect=1;connectable=0;image=" + img.uri + ";") +
        '" vertex="1" parent="' + xml(o.id) + '">' +
        '<mxGeometry x="' + x + '" y="' + y + '" width="' + iw + '" height="' + ih + '" as="geometry"/></mxCell>';
}

// ---------------------------------------------------------------------------
// Styles

function styleNoeud(o, estConteneur, image) {
    var t = o.type;
    var s = fusionner({}, "whiteSpace=wrap;html=1;verticalAlign=top;align=center");

    if (t === "diagram-model-image") {
        // Objet image d'Archi : l'image occupe tout le cadre.
        fusionner(s, image ? "shape=image;imageAspect=0;image=" + image.uri : "dashed=1;fillColor=none");
    } else if (t === "diagram-model-note") {
        fusionner(s, "shape=note;size=12;align=left;spacingLeft=4;fillColor=#FFFFFF");
    } else if (t === "diagram-model-group") {
        fusionner(s, "rounded=0;align=left;spacingLeft=4;fontStyle=1;fillColor=#D2D7D7");
    } else if (t === "diagram-model-reference") {
        fusionner(s, "rounded=0;dashed=1;fillColor=#DCEBFF");
    } else if (t === "grouping") {
        fusionner(s, "shape=mxgraph.archimate3.application;appType=grouping;archiType=square;" +
            "outlineConnect=0;dashed=1;align=left;spacingLeft=4;fillColor=none");
    } else if (t === "junction") {
        var ou = lire(lire(o, "concept") || {}, "junctionType") === "or";
        fusionner(s, "ellipse;aspect=fixed;fillColor=" + (ou ? "#FFFFFF" : "#000000"));
    } else {
        fusionner(s, "shape=mxgraph.archimate3.application;outlineConnect=0;appType=" + appType(t) +
            ";fillColor=" + COULEURS[couche(t)]);
        if (!SANS_ARCHITYPE[t]) s.archiType = archiType(t);
        // Règle d'Archi : l'image remplace l'icône, sauf icône forcée.
        // appType=generic : cadre conservé, sans pictogramme.
        var icone = lire(o, "showIcon");
        if (icone === ICONE_JAMAIS || (image && icone !== ICONE_TOUJOURS)) s.appType = "generic";
    }

    if (estConteneur) fusionner(s, "container=1;collapsible=0");

    // Personnalisations faites dans Archi.
    var v;
    if ((v = lire(o, "fillColor"))) s.fillColor = v;
    if ((v = lire(o, "lineColor"))) s.strokeColor = v;
    if ((v = lire(o, "fontColor"))) s.fontColor = v;
    if ((v = lire(o, "fontSize"))) s.fontSize = v;
    if ((v = ALIGNEMENT[lire(o, "textAlignment")])) s.align = v;
    if ((v = POSITION[lire(o, "textPosition")])) s.verticalAlign = v;
    return serialiser(s);
}

function styleConnexion(c) {
    var s = fusionner({}, "html=1;rounded=0;endArrow=none;startArrow=none;labelBackgroundColor=#FFFFFF");
    var r = lire(c, "concept");
    fusionner(s, RELATIONS[c.type]);
    if (c.type === "access-relationship" && r) fusionner(s, SENS_ACCES[lire(r, "accessType")]);
    if (c.type === "association-relationship" && r && lire(r, "associationDirected")) fusionner(s, "endArrow=openAsync");
    var v;
    if ((v = lire(c, "lineColor"))) s.strokeColor = v;
    if ((v = lire(c, "fontColor"))) s.fontColor = v;
    return serialiser(s);
}

function cellule(id, label, meta, attrsCellule, geometrie) {
    return '<UserObject id="' + xml(id) + '" label="' + label + '"' + meta + '>' +
        '<mxCell ' + attrsCellule + '>' + geometrie + '</mxCell></UserObject>';
}

/** Exporte un objet et ses enfants. Les coordonnées Archi sont relatives au parent, comme dans draw.io. */
function exporterNoeud(o, parentId, origine, sortie, absolus) {
    var b = o.bounds;
    var image = imageDe(o);
    var estImage = o.type === "diagram-model-image";
    // -1 : taille par défaut d'Archi. Pour un objet image, c'est la taille de l'image.
    var w = b.width > 0 ? b.width : (estImage && image && image.width) || TAILLE_DEFAUT.width;
    var h = b.height > 0 ? b.height : (estImage && image && image.height) || TAILLE_DEFAUT.height;
    var abs = { x: origine.x + b.x, y: origine.y + b.y, width: w, height: h };
    absolus[o.id] = abs;

    var enfants = $(o).children().filter(function (e) { return !estConnexion(e); });
    var texte = o.type === "diagram-model-note" ? lire(o, "text") : estImage ? "" : lire(o, "name");

    sortie.push(cellule(o.id, libelle(texte), metadonnees(o),
        'style="' + xml(styleNoeud(o, enfants.size() > 0, image)) + '" vertex="1" parent="' + xml(parentId) + '"',
        '<mxGeometry x="' + b.x + '" y="' + b.y + '" width="' + w + '" height="' + h + '" as="geometry"/>'));

    if (image && !estImage) sortie.push(celluleImage(o, image, w, h));

    enfants.each(function (e) { exporterNoeud(e, o.id, abs, sortie, absolus); });
}

/**
 * Point de référence d'une extrémité, comme l'ancre d'Archi : centre d'une
 * forme ; milieu d'une relation quand l'extrémité est une relation.
 */
function reference(o, absolus, profondeur) {
    var a = absolus[o.id];
    if (a) return { x: a.x + a.width / 2, y: a.y + a.height / 2 };
    if (profondeur > 10 || !estConnexion(o)) return null;
    var p = reference(o.source, absolus, profondeur + 1), q = reference(o.target, absolus, profondeur + 1);
    return p && q ? { x: (p.x + q.x) / 2, y: (p.y + q.y) / 2 } : null;
}

/**
 * Points de cassure en coordonnées absolues, formule d'Archi (GEF RelativeBendpoint) :
 * point i = (1 − w)·(réf. source + début) + w·(réf. cible + fin), avec w = (i + 1) / (n + 1).
 */
function points(c, absolus) {
    var bp = lire(c, "relativeBendpoints");
    if (!bp || bp.length === 0) return "";
    var a1 = reference(c.source, absolus, 0), a2 = reference(c.target, absolus, 0);
    if (!a1 || !a2) return "";
    var n = bp.length, out = "";
    for (var i = 0; i < n; i++) {
        var w = (i + 1) / (n + 1);
        var x = (1 - w) * (a1.x + bp[i].startX) + w * (a2.x + bp[i].endX);
        var y = (1 - w) * (a1.y + bp[i].startY) + w * (a2.y + bp[i].endY);
        out += '<mxPoint x="' + Math.round(x) + '" y="' + Math.round(y) + '"/>';
    }
    return '<Array as="points">' + out + '</Array>';
}

function exporterVue(vue) {
    var sortie = [], absolus = {};
    $(vue).children().filter(function (e) { return !estConnexion(e); }).each(function (o) {
        exporterNoeud(o, "1", { x: 0, y: 0 }, sortie, absolus);
    });
    // Les connexions viennent après les nœuds : draw.io résout source et cible par id.
    $(vue).find().filter(estConnexion).each(function (c) {
        sortie.push(cellule(c.id, libelle(lire(c, "name")), metadonnees(c),
            'style="' + xml(styleConnexion(c)) + '" edge="1" parent="1" source="' + xml(c.source.id) +
            '" target="' + xml(c.target.id) + '"',
            '<mxGeometry relative="1" as="geometry">' + points(c, absolus) + '</mxGeometry>'));
    });
    return '<diagram id="' + xml(vue.id) + '" name="' + xml(vue.name) + '">' +
        '<mxGraphModel grid="1" gridSize="12" page="0"><root>' +
        '<mxCell id="0"/><mxCell id="1" parent="0"/>' + sortie.join("") +
        '</root></mxGraphModel></diagram>';
}

// ---------------------------------------------------------------------------

exigerModele();
console.clear();
titre("Export draw.io");

var vues = vuesSelectionnees();
if (vues.length === 0) {
    console.error("Aucune vue ArchiMate dans la sélection.");
    exit();
}

archive = archiveDuModele();

var nomFichier = nomDeFichier(vues.length === 1 ? vues[0].name : model.name, "drawio");
var chemin = window.promptSaveFile({
    title: "Exporter vers draw.io",
    filterExtensions: ["*.drawio"],
    fileName: nomFichier
});
if (!chemin) exit();

$.fs.writeFile(chemin, '<?xml version="1.0" encoding="UTF-8"?>\n<mxfile host="jArchi">' +
    vues.map(exporterVue).join("") + '</mxfile>\n');

vues.forEach(function (v) { console.log("Vue exportée : " + v.name); });
console.log(vues.length + " page(s) écrite(s) dans " + chemin);
